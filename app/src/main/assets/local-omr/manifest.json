  "modifications": [
    "Workers use only APK-local resources; no CDN and no score upload.",
    "Python and ORT execute in independent workers connected by app-local synchronous-XHR binary RPC.",
    "JSPI/run_sync/callPromising were removed from the active Python bridge; SharedArrayBuffer and cross-origin isolation are not required.",
    "ORT compatibility execution uses CPU/WASM with numThreads=1.",
    "Tensor payloads remain binary; native bridge delivery is chunked rather than serializing tensors as numeric JSON arrays.",
    "Piano runner retains upstream grand-staff grouping, including same-clef staves.",
    "Choir-specific Partsong splitting and key rewriting are not applied.",
    "Partsong JavaScript decoder acceleration and generic zero-duration-rest handling retained."
  ],
  "workerLoader": "APK-local classic Blob bootstrap imports the two local ES modules and reports import errors with stage and stack.",
  "limits": [
    "Requires classic workers with dynamic ES module import, WebAssembly SIMD, local worker XMLHttpRequest and the app native RPC bridge.",
    "Recognition output requires human review.",
    "Training-data licensing details are preserved in licenses/HOMR-LICENSE-FAQ.md."
  ],
